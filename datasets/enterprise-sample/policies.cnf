c CyberShield security-policy constraints, 3-SAT in DIMACS CNF format
c var 1 = mfa_required
c var 2 = vpn_only_admin
c var 3 = legacy_ssh_password
c var 4 = network_segmentation
c var 5 = guest_wifi_enabled
c var 6 = edr_on_all_hosts
p cnf 6 9
1 2 -3 0
-1 3 4 0
-3 -5 6 0
2 4 -5 0
-2 5 6 0
1 -4 6 0
-1 -2 4 0
3 -5 -6 0
-4 5 -6 0
