<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cybershield</groupId>
  <artifactId>cybershield</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>CyberShield - Enterprise Security Analytics Platform</name>
  <description>Java DSA-powered security analytics with a live algorithm-visualisation dashboard.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- The application itself has NO runtime dependencies (JDK HttpServer, own JSON). JUnit is test-only. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cybershield</finalName>
    <!-- dashboard/ and datasets/ live at the project root and are packaged onto the classpath -->
    <resources>
      <resource><directory>dashboard</directory><targetPath>dashboard</targetPath></resource>
      <resource><directory>datasets</directory><targetPath>datasets</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest><mainClass>com.cybershield.CyberShieldApp</mainClass></manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration><mainClass>com.cybershield.CyberShieldApp</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
